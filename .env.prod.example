# Copie para .env (na raiz) antes de rodar docker-compose.prod.yml
# cp .env.prod.example .env && edite os valores

# OBRIGATÓRIO — segredo dos tokens JWT (REST + WebSocket). Gere um valor forte:
#   openssl rand -hex 32
JWT_SECRET=

# Origem permitida (CORS + Socket.io). Em produção use o domínio real do frontend.
CORS_ORIGIN=https://genesis.seudominio.com

# Porta pública do frontend (nginx)
WEB_PORT=8080

# Admin criado no primeiro boot
ADMIN_EMAIL=administrador@admin.com.br
ADMIN_PASSWORD=troque-no-primeiro-acesso
