# Copie para .env e ajuste os valores

# String de conexão do MongoDB.
# As movimentações de estoque usam TRANSAÇÕES: o Mongo precisa ser um replica set (o docker-compose já sobe assim).
# Rodando o backend FORA do Docker contra o Mongo do compose, use directConnection=true
# (o replica set anuncia o host interno "genesis-db", que a sua máquina não resolve).
MONGO_URI=mongodb://localhost:27017/genesis?directConnection=true

# Segredo usado para assinar/validar tokens JWT (REST + WebSocket) — troque em produção
JWT_SECRET=troque_este_valor

# Porta do servidor HTTP + WebSocket
PORT=3000

# Rate limit geral da API (requisições por minuto por IP)
RATE_LIMIT_MAX=300

# Origem permitida para CORS (REST e Socket.io). Em produção: domínio do frontend.
CORS_ORIGIN=*

# Admin criado automaticamente pelo seeder na primeira execução
ADMIN_EMAIL=administrador@admin.com.br
ADMIN_PASSWORD=admin123

# development | production
NODE_ENV=development
