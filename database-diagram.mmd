erDiagram
  %% Genesis — modelo de dados após o roadmap G0–G11.
  %% Hierarquia: Ficha → Modelo de Fichário → Fichário físico. NENHUMA quantidade é gravada:
  %% saldos (fichário, em jogo, divergência) são DERIVADOS de Movement (Σ to − Σ from).

  User {
    ObjectId _id PK
    String   name
    String   email "unique"
    String   password "bcrypt"
    String   role "admin | material | salao"
    ObjectId allowed_tournament_ids "escopo por torneio (vazio = todos)"
    Number   session_version
  }

  Chip {
    ObjectId _id PK
    Number   value "valor NOMINAL (a ficha jamais tem valor monetário)"
    String   color "hex"
    Boolean  active
    String   name "derivado"
  }

  BinderModel {
    ObjectId _id PK
    String   name
  }
  BinderModel_Composition {
    ObjectId binder_model_id FK
    ObjectId chip_id FK
    Number   quantity
  }

  Binder {
    ObjectId _id PK
    String   name
    String   code
    ObjectId model_id FK
    String   status "available | allocated | maintenance (derivado, exceto manutenção)"
  }

  Movement {
    ObjectId _id PK "IMUTÁVEL"
    String   type "ASSEMBLY WITHDRAWAL ADJUSTMENT LOSS FOUND RECOVERY REVERSAL SEND_* RETURN CHIP_RACE_* COLOR_UP_* DISCARD"
    ObjectId chip_id FK
    Number   quantity "> 0"
    Object   from "kind: external | binder | lost | play + id"
    Object   to "idem"
    ObjectId binder_id FK
    ObjectId tournament_id FK
    ObjectId session_id FK
    ObjectId batch_id "lote gravado junto"
    ObjectId reverses FK "estorno → original (único)"
    String   reason
    Object   meta "occurrence_id…"
    String   user_name
    Date     createdAt
  }

  BalanceLock {
    String _id PK "kind:id:chip — serializa lançamentos concorrentes"
  }

  Event {
    ObjectId _id PK
    String   name
    Date     start_date
    Date     end_date
  }

  Tournament {
    ObjectId _id PK
    ObjectId event_id FK
    Number   number
    String   name
    Date     date
    String   status "scheduled | running | paused | finished | finalized"
    ObjectId stack_model_id FK "modelo padrão"
    Number   buy_in
    Number   bounty_value
    Date     deleted_at "soft delete"
  }

  TournamentSession {
    ObjectId _id PK
    ObjectId tournament_id FK
    String   name "Dia 1A, Dia Final…"
    String   status "scheduled | running | finished"
  }

  StackModel {
    ObjectId _id PK
    String   name
    Object   actions "buy_in, re_entry, add_on…"
  }
  StackModel_Composition {
    ObjectId stack_model_id FK
    ObjectId chip_id FK
    Object   quantities "por ação"
  }

  Allocation {
    ObjectId _id PK
    ObjectId binder_id FK
    ObjectId tournament_id FK
    String   status "planned | active | released"
    Boolean  open
  }
  Allocation_Chips {
    ObjectId allocation_id FK
    ObjectId chip_id FK
    Number   quantity "TETO do envio"
  }

  Conversion {
    ObjectId _id PK
    ObjectId tournament_id FK
    String   type "CHIP_RACE | COLOR_UP"
    Number   value_out
    Number   value_in
    Number   math_breakage "value_in − value_out (não é perda)"
    ObjectId movement_batch_id
    String   status "active | reversed"
  }

  Occurrence {
    ObjectId _id PK
    String   kind "LOSS | SURPLUS"
    String   scope "binder | tournament"
    ObjectId chip_id FK
    ObjectId binder_id FK
    ObjectId tournament_id FK
    Number   expected
    Number   counted
    String   severity "GREEN | YELLOW | RED"
    String   status "open justified partially_recovered recovered closed voided"
    Object   history "trilha completa"
  }

  TournamentEntry {
    ObjectId _id PK
    ObjectId tournament_id FK
    ObjectId session_id FK
    Number   number "Entrada #n (sequência do torneio)"
    String   type "buy-in | re-entry | add-on"
    String   status "active | cancelled (com motivo)"
  }

  Elimination {
    ObjectId _id PK
    ObjectId tournament_id FK
    ObjectId entry_id FK "a ENTRADA eliminada"
    Number   position
    String   status "active | cancelled (com motivo)"
  }

  Seat {
    ObjectId _id PK
    ObjectId tournament_id FK
    ObjectId session_id FK
    ObjectId entry_id FK "quem ocupa o lugar: a ENTRADA"
  }

  PayoutTemplate {
    ObjectId _id PK
    String   name
  }
  BlindStructureTemplate {
    ObjectId _id PK
    String   name
  }
  Setting {
    String key PK "severity (semáforo)"
    Object value
  }
  ChatMessage {
    ObjectId _id PK
    String   channel
    Boolean  is_urgent
  }
  ActivityLog {
    ObjectId _id PK
    String   category
    String   action
    String   user_name
  }

  BinderModel ||--o{ BinderModel_Composition : "composição"
  Chip ||--o{ BinderModel_Composition : ""
  BinderModel ||--o{ Binder : "segue"
  Binder ||--o{ Movement : "saldo = Σ movimentos"
  Chip ||--o{ Movement : ""
  Tournament ||--o{ Movement : "em jogo"
  Movement ||--o| Movement : "estorno (reverses)"
  Event ||--o{ Tournament : ""
  Tournament ||--o{ TournamentSession : "sessões"
  Tournament }o--o| StackModel : "modelo padrão"
  StackModel ||--o{ StackModel_Composition : ""
  Chip ||--o{ StackModel_Composition : ""
  Binder ||--o{ Allocation : ""
  Tournament ||--o{ Allocation : "reserva (teto de envio)"
  Allocation ||--o{ Allocation_Chips : ""
  Chip ||--o{ Allocation_Chips : ""
  Tournament ||--o{ Conversion : "chip race / color up"
  Chip ||--o{ Occurrence : ""
  Binder ||--o{ Occurrence : "divergência de fichário"
  Tournament ||--o{ Occurrence : "divergência em jogo"
  Occurrence ||--o{ Movement : "LOSS / FOUND / RECOVERY (meta.occurrence_id)"
  Tournament ||--o{ TournamentEntry : ""
  TournamentSession ||--o{ TournamentEntry : ""
  Tournament ||--o{ Elimination : ""
  TournamentEntry ||--o| Elimination : "eliminada"
  Tournament ||--o{ Seat : ""
  TournamentEntry ||--o| Seat : "ocupa"
  User }o--o{ Tournament : "allowed_tournament_ids"
